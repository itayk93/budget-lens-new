# Copy to .env and fill in. The .env file is gitignored and must never be committed.
# These VITE_ values are public (anon) client config — safe to expose in the browser.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# ----------------------------------------------------------------------------
# The following are SERVER-SIDE SECRETS. They are NOT used by the Vite client.
# Configure them only as Supabase Edge Function secrets (never in this file):
#   SUPABASE_SERVICE_ROLE_KEY   - full DB access, bypasses RLS
#   BREVO_API_KEY               - Brevo transactional email API key
#   BREVO_SENDER_EMAIL          - verified sender email for Brevo
#   LEAD_NOTIFICATION_EMAIL     - inbox that receives lead notifications
#   LOVABLE_API_KEY             - AI gateway key (billed per use)
#   SFTP_PASSWORD               - SFTP credential
#   SFTP_GATEWAY_URL            - must be https://
#   ADMIN_BASE_URL              - origin of the admin console linked from lead push
#                                 notifications (unlisted; keep it out of the repo)
# ----------------------------------------------------------------------------

# Food map pipeline (local runs and the foodmap-rescan workflow).
# Outputs are gitignored and published to the owner's RLS-protected feed row.
GOOGLE_MAPS_API_KEY=
FOOD_MAP_OWNER_EMAIL=
# Alternatively pin the auth user id directly:
FOOD_MAP_OWNER_USER_ID=

# Optional: Riseup capture scripts (defaults to ~/.riseup-profile)
RISEUP_PROFILE_DIR=
# Optional: local CSV export consumed by the one-off reconciliation scripts
RISEUP_CSV=

# Local bank scraping automation (.env.local / local task only)
CAL_USERNAME=
CAL_PASSWORD=
MAX_USERNAME=
MAX_PASSWORD=
YAHAV_USERNAME=
YAHAV_NATIONAL_ID=
YAHAV_PASSWORD=
AMEX_ID=
AMEX_CARD6DIGITS=
AMEX_PASSWORD=
BANK_SCRAPER_REPORT_EMAIL=
# Optional comma-separated fallback/secondary recipients for the local bank scraper report
BANK_SCRAPER_REPORT_EMAILS=

# Optional: direct OpenAI fallback for merchant categorization
OPENAI_API_KEY=
